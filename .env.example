# Public Supabase project configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only secrets. Never commit real values or expose them in frontend code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
YOUTUBE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
HYPECUT_OAUTH_STATE_SECRET=GENERATE_A_LONG_RANDOM_SECRET
HYPECUT_TOKEN_ENCRYPTION_KEY=GENERATE_A_FERNET_URLSAFE_BASE64_KEY

# OAuth redirect URI must exactly match the Google Cloud OAuth client configuration.
YOUTUBE_REDIRECT_URI=https://hypecut-api-production.up.railway.app/oauth/youtube/callback
FRONTEND_URL=https://headless-osivutkraak-aarexex-1407.wix-site-host.com
CORS_ORIGINS=https://headless-osivutkraak-aarexex-1407.wix-site-host.com
ENVIRONMENT=production

# Live worker configuration (worker service only)
HYPECUT_HLS_BASE_URL=https://YOUR_MEDIAMTX_HLS_HOST
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
HYPECUT_HIGHLIGHT_MODEL=gpt-4o-mini
HYPECUT_LIVE_WINDOW_SECONDS=60
HYPECUT_LIVE_MIN_SCORE=72
