# Public Supabase project configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=https://your-hypecut-site.example

ENVIRONMENT=production

# Never place Supabase service-role keys, OAuth client secrets,
# or AI provider secrets in frontend code or commit them to Git.
